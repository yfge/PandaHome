# PandaHome API environment configuration
# Copy this file to `api/.env` and replace the placeholder values.

DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_TOKEN_URL=/api/auth/token
AUTH_HASHING_SCHEMES=bcrypt
AUTH_HASHING_DEPRECATED=auto

# Aliyun DNS credentials
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_REGION_ID=cn-hangzhou

# Managed public services (direct UPnP + DDNS or native frp relay)
# Run one API worker per database/state directory. See docs/public-access.md.
ACCESS_CHECK_INTERVAL_SECONDS=60
# Optional HTTPS URL of a REMOTE Prometheus blackbox exporter /probe endpoint.
# It must provide module=tcp_connect. Leave blank for explicitly unverified entries.
ACCESS_PROBE_URL=
# Optional HTTPS webhook: receives sustained failure and verified recovery only.
ACCESS_ALERT_WEBHOOK=
ACCESS_ALERT_FAILURE_THRESHOLD=3
RELAY_BINARY=frpc
RELAY_SERVER_ADDR=
RELAY_SERVER_PORT=7000
# Public IP/DNS host for forwarded traffic; defaults to RELAY_SERVER_ADDR.
RELAY_PUBLIC_HOST=
RELAY_TOKEN=
RELAY_STATE_DIR=~/.local/state/pandahome
